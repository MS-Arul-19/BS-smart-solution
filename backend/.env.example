# ---- Server ----
NODE_ENV=development
PORT=5000

# ---- Database (PostgreSQL) ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bs_smart_solution?schema=public

# ---- JWT (both secrets MUST be different, >= 32 chars) ----
JWT_ACCESS_SECRET=change-me-to-a-random-string-of-32-plus-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=change-me-to-a-DIFFERENT-random-32-plus-chars
JWT_REFRESH_EXPIRES=7d

# ---- CORS (comma separated origins) ----
CORS_ORIGINS=http://localhost:5173

# ---- Business ----
WHATSAPP_NUMBER=919876543210

# ---- Seed admin (used once by prisma/seed.js) ----
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@bssmartsolution.com
SEED_ADMIN_PASSWORD=ChangeMe@123

# ---- Uploads ----
MAX_FILE_SIZE_MB=2
